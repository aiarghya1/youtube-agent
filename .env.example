# ---- Copy this file to .env and fill in the values ----

# YouTube Data API v3 key (from Google Cloud Console).
# See README.md "Getting a YouTube API key" for step-by-step instructions.
YOUTUBE_API_KEY=

# Gmail address the report is sent FROM and TO.
GMAIL_ADDRESS=aiarghya1@gmail.com

# Gmail App Password (16 chars, NOT your normal password).
# See README.md "Getting a Gmail app password".
GMAIL_APP_PASSWORD=

# Where to send the daily report. Defaults to GMAIL_ADDRESS if blank.
REPORT_TO=aiarghya1@gmail.com

# OPTIONAL: enables richer qualitative analysis of hooks/topics via Claude.
# Leave blank to use the built-in (free) heuristic analysis only.
ANTHROPIC_API_KEY=
